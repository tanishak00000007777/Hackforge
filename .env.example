APP_NAME=HackForge
APP_VERSION=0.1.0
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production

# PostgreSQL connection string (local or production)
# Format: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hackforge
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
FRONTEND_URL=http://127.0.0.1:5174
# Cloudinary (required for form file-upload questions)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Leave blank to use the deterministic fallback engine.
AI_GROQ_API_KEY=
AI_GEMINI_API_KEY=
# Optional AI overrides; defaults are shown below.
# AI_GROQ_MODEL=llama-3.3-70b-versatile
# AI_GEMINI_MODEL=gemini-flash-latest
# AI_REQUEST_TIMEOUT_SECONDS=45
# AI_REQUESTS_PER_MINUTE=10
# AI_MAX_TOKENS=4000
