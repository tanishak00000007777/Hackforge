{
  "name": "hackforge",
  "private": true,
  "description": "Root orchestration for the HackForge FastAPI API and primary web app with inline Website Studio.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:web": "npm --prefix FrontEnd/hackforge-react run dev",

    "build": "npm --prefix FrontEnd/hackforge-react run build",

    "start": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",

    "test": "npm run test:api",
    "test:api": "python -m pytest tests -q",
    "test:legacy-studio": "npm --prefix FrontEnd/EditorWindow test",

    "lint": "npm run lint:web",
    "lint:web": "npm --prefix FrontEnd/hackforge-react run lint",
    "lint:legacy-studio": "npm --prefix FrontEnd/EditorWindow run lint",

    "install:all": "npm install && npm --prefix FrontEnd/hackforge-react install",
    "install:legacy-studio": "npm --prefix FrontEnd/EditorWindow install"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
