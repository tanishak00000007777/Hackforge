# AI providers for the ForgeAI copilot.
#
# Every provider accepts a COMMA-SEPARATED list of keys. Each key is its own
# budget, so when one is exhausted the editor rolls to the next automatically.
# Order matters: the first configured credential is tried first.

# Optional. Default order is groq,gemini,kimi.
# VITE_AI_PROVIDER_ORDER=groq,gemini,kimi

# Optional per-provider model overrides. Defaults:
#   groq   -> llama-3.3-70b-versatile   (12k tokens/min, 100k/day on free tier)
#   gemini -> gemini-2.0-flash
#   kimi   -> kimi-k2-0711-preview
# VITE_GROQ_MODEL=llama-3.1-8b-instant
# VITE_GEMINI_MODEL=gemini-2.0-flash
# VITE_KIMI_MODEL=kimi-k2-0711-preview

# Optional base-URL overrides (self-hosted or regional endpoints).
# VITE_KIMI_BASE_URL=https://api.moonshot.cn/v1

# Optional generation settings.
# VITE_AI_MAX_TOKENS=800
# VITE_AI_TEMPERATURE=0.1

# AI editing backend (AI/personaforge). Leave unset to use the vite /api proxy.
# VITE_AI_API_URL=http://localhost:8000

# HackForge integration. Both origins must be exact, including scheme and port.
VITE_APP_ORIGIN=http://127.0.0.1:5174
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# AI provider keys belong in the backend root .env, never in a VITE_ variable.
