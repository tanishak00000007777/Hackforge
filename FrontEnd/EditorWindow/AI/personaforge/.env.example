# Copy to .env and fill in. Any OpenAI-compatible chat-completions endpoint works.
# If left unset, PersonaForge uses GROQ_API_KEY / VITE_GROQ_API_KEY (also read
# from the studio's .env one level up) and defaults to Groq; with no key at all
# it falls back to a local Ollama at http://localhost:11434/v1.

# PERSONAFORGE_LLM_BASE_URL=https://api.groq.com/openai/v1
# Default is llama-3.1-8b-instant (fits the free tier's daily budget).
# llama-3.3-70b-versatile plans better but exhausts a free key in ~2 jobs.
# PERSONAFORGE_LLM_MODEL=llama-3.3-70b-versatile
# PERSONAFORGE_LLM_API_KEY=
# PERSONAFORGE_LLM_TIMEOUT=60

# Only when the studio is served from a different origin than this API.
# PERSONAFORGE_CORS_ORIGINS=http://localhost:5173
